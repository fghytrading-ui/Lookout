PORT=3001

# ── Optional: Polygon.io for real-time, no-rate-limit market data ───────
# Sign up at https://polygon.io (Starter plan ~$29/month)
# Paste your API key here, then restart the backend.
# When set, the system automatically uses Polygon for live prices.
# When empty (or commented out), falls back to Yahoo Finance (free, rate-limited).
# POLYGON_API_KEY=your_polygon_api_key_here

# ── Optional: cross-source price verification ─────────────────────────
# When set to 'true', verifies Polygon prices against Yahoo and warns on divergence
# VERIFY_PRICES=true

# ── Other optional API keys ────────────────────────────────────────────
# TRADINGECONOMICS_API_KEY=your_te_key_here
# TWELVE_DATA_API_KEY=your_twelve_data_key_here
